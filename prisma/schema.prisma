generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Farmer {
  id            String       @id @default(cuid())
  fullName      String
  municipality  String
  barangay      String
  contactNumber String?      @unique
  status        FarmerStatus @default(PENDING)
  verifiedAt    DateTime?
  createdAt     DateTime     @default(now())
  submissions   Submission[]
  attachments   Attachment[]
}

model Attachment {
  id        String   @id @default(cuid())
  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId  String
  fileName  String
  mimeType  String
  size      Int
  blobUrl   String
  createdAt DateTime @default(now())
}

model Submission {
  id               String           @id @default(cuid())
  farmer           Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId         String
  referenceNumber  String           @unique
  cropCategory     CropCategory
  cropName         String
  customCrop       String?
  plantingDate     DateTime         @db.Date
  harvestDate      DateTime         @db.Date
  farmSizeHectares Decimal?         @db.Decimal(8, 2)
  farmSizeSqm      Decimal?         @db.Decimal(10, 2)
  gpsLat           Decimal?         @db.Decimal(10, 7)
  gpsLng           Decimal?         @db.Decimal(10, 7)
  photoData        Bytes?
  photoMime        String?
  issues           String[]
  pointsEarned     Int              @default(0)
  status           SubmissionStatus @default(PENDING)
  submittedAt      DateTime         @default(now())
}

model LguUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
}

enum CropCategory {
  LEAFY_VEGETABLES
  FRUITING_VEGETABLES
  ROOT_CROPS
  HIGH_VALUE_CROPS
}

enum SubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FarmerStatus {
  PENDING
  APPROVED
  REJECTED
}
